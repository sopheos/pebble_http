{
    "name": "sopheos/pebble_http",
    "description": "Request / Response library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-factory": "^1.0",
        "nyholm/psr7": "^1.8"
    },
    "provide": {
        "psr/http-message-implementation": "1.0",
        "psr/http-factory-implementation": "1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "guzzlehttp/psr7": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Pebble\\Http\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
